<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Invisia Agent"
           Language="1033"
           Codepage="65001"
           Version="1.0.0"
           Manufacturer="Invisia"
           UpgradeCode="A3B2C1D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"
             Platform="x64" />

    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Ya existe una versión más reciente. Desinstálala primero." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Invisia Agent" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AgentExe" Guid="B4C3D2E1-F5A6-7890-ABCD-EF1234567891" Win64="yes">
        <File Id="AgentExeFile"
              Name="invisia-agent.exe"
              Source="..\invisia-agent.exe"
              KeyPath="yes"
              Vital="yes" />

        <ServiceInstall Id="InvisiaServiceInstall"
                        Name="InvisiaAgent"
                        DisplayName="Invisia Agent"
                        Description="Invisia database monitoring and auditing agent - Law 21.719 Chile"
                        Start="auto"
                        Type="ownProcess"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes" />

        <ServiceControl Id="StartInvisiaService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="InvisiaAgent"
                        Wait="yes" />
      </Component>

      <Component Id="ConfigFile" Guid="C5D4E3F2-A6B7-8901-CDEF-123456789012" Win64="yes">
        <File Id="ConfigFile"
              Name="config.json"
              Source="config.template.json"
              KeyPath="yes"
              Vital="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="CompleteInstall"
             Title="Invisia Agent"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="AgentExe" />
      <ComponentRef Id="ConfigFile" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Product>
</Wix>
