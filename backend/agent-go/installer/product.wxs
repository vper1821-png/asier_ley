<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="SecureLab Agent" 
           Language="1033" 
           Version="$(var.Version)" 
           Manufacturer="SecureLab" 
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine"
             Description="SecureLab Security Agent - Endpoint protection and database compliance monitoring"
             Manufacturer="SecureLab"
             Comments="Installs the SecureLab Agent as a Windows Service"/>

    <Media Id="1" Cabinet="invisia.cab" EmbedCab="yes"/>
    <MajorUpgrade DowngradeErrorMessage="A newer version of SecureLab Agent is already installed."/>
    
    <Property Id="ARPHELPLINK" Value="https://securelab.cl/support"/>
    <Property Id="ARPURLINFOABOUT" Value="https://securelab.cl"/>
    <Property Id="ARPCOMMENTS" Value="SecureLab Security Agent - Endpoint protection and database compliance monitoring"/>
    <Property Id="ARPCONTACT" Value="support@securelab.cl"/>
    <Property Id="ARPURLUPDATEINFO" Value="https://securelab.cl/download"/>
    
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="SECURELABDIR" Name="SecureLab">
          <Directory Id="INSTALLDIR" Name="Agent">
            <Component Id="AgentFiles" Guid="*" Win64="yes">
              <File Id="securelab_agent_exe" 
                    Name="securelab-agent.exe" 
                    Source="$(var.ExeSource)" 
                    KeyPath="yes"/>
              <ServiceInstall Id="ServiceInstaller"
                              Type="ownProcess"
                              Vital="yes"
                              Name="SecureLabAgent"
                              DisplayName="SecureLab Agent"
                              Description="SecureLab Security Agent - Provides endpoint protection, user monitoring, firewall management, and database compliance scanning."
                              Start="auto"
                              Account="NT AUTHORITY\SYSTEM"
                              ErrorControl="normal"
                              Interactive="no">
                <ServiceDependency Id="Tcpip"/>
                <ServiceDependency Id="Dhcp"/>
              </ServiceInstall>
              <ServiceControl Id="StartService"
                              Name="SecureLabAgent"
                              Start="install"
                              Stop="both"
                              Remove="uninstall"
                              Wait="yes"/>
            </Component>

            <Component Id="ConfigFile" Guid="*" Win64="yes">
              <File Id="config_json"
                    Name="config.json"
                    Source="$(var.ConfigSource)"
                    KeyPath="yes"/>
            </Component>
            
            <Component Id="RegistryEntries" Guid="*" Win64="yes">
              <RegistryKey Root="HKLM" Key="SOFTWARE\SecureLab\Agent">
                <RegistryValue Type="string" Name="InstallPath" Value="[INSTALLDIR]" KeyPath="yes"/>
                <RegistryValue Type="string" Name="Version" Value="$(var.Version)"/>
                <RegistryValue Type="string" Name="InstallDate" Value="[Date]"/>
              </RegistryKey>
              <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\SecureLabAgent" Name="DelayedAutoStart" Value="1" Type="integer"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>
    
    <Feature Id="MainFeature" 
             Title="SecureLab Agent" 
             Description="Installs the SecureLab security agent as a Windows service."
             Level="1"
             ConfigurableDirectory="INSTALLDIR">
      <ComponentRef Id="AgentFiles"/>
      <ComponentRef Id="ConfigFile"/>
      <ComponentRef Id="RegistryEntries"/>
    </Feature>
    
  </Product>
</Wix>
